#!/usr/bin/env zsh
set -euo pipefail

VERSION="0.2.0"
ROOT="${0:A:h:h}"
LC_HOME="${LOCALCODE_HOME:-$HOME/.localcode}"
BASE_URL="${LOCALCODE_BASE_URL:-https://llm.masa.gi/v1}"
MODEL=""
CONTEXT_TOKENS=0
MAX_TOKENS=0
BODY_LIMIT_BYTES=0
MAX_CONCURRENT=0
MODELS_JSON=""
LC_ERR=""
RELEASES_URL="${LOCALCODE_RELEASES_URL:-https://api.github.com/repos/ordishs/localcode/releases/latest}"
TAP_FORMULA="ordishs/tap/localcode"
export MASA_TOKEN="${MASA_TOKEN:-${LOCAL_LLM_API_KEY:-}}"

usage() {
  cat <<'EOF'
localcode wraps the pi coding agent and points it at the abila inference gateway.

Usage:
  localcode [pi args...]          start pi on the gateway model
  localcode init                  create or refresh the config dir
  localcode update [--check]      upgrade localcode, or only report the latest release
  localcode doctor                check pi, token, gateway, gh, and web tools
  localcode models                list the gateway models with their context and output limits
  localcode install <source>      add your own tooling, for example npm:pi-web-access
  localcode remove <source>       remove tooling you installed
  localcode packages              list tooling installed in the config dir
  localcode exa on|off            toggle the bundled Exa web tools
  localcode gh <args>             run GitHub CLI with the same environment
  localcode config                print resolved paths and settings
  localcode version               print versions

Environment:
  MASA_TOKEN                 gateway access token (falls back to LOCAL_LLM_API_KEY)
  EXA_API_KEY                optional, enables the bundled web_search tool
  LOCALCODE_HOME             config dir, default ~/.localcode
  LOCALCODE_BASE_URL         gateway endpoint, default https://llm.masa.gi/v1
  LOCALCODE_MODEL            model id to use, default the first model the gateway lists
  LOCALCODE_RELEASES_URL     latest release endpoint, default the GitHub API for ordishs/localcode

Install pi from https://pi.dev first:
  npm install -g @earendil-works/pi-coding-agent
EOF
}

die() {
  print -u2 "localcode: $1"
  exit 1
}

need_tool() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required. $2"
}

exa_enabled() {
  [[ ! -e "$LC_HOME/exa.disabled" ]]
}

seed() {
  mkdir -p "$LC_HOME/extensions"
  [[ -e "$LC_HOME/settings.json" ]] || cp "$ROOT/config/settings.json" "$LC_HOME/settings.json"
  cp "$ROOT/extensions/exa.ts" "$LC_HOME/extensions/exa.ts"
}

fetch_models() {
  local out
  if ! out="$(curl -sS -m 30 -H "Authorization: Bearer $MASA_TOKEN" "$BASE_URL/models" 2>&1)"; then
    LC_ERR="cannot reach the gateway at $BASE_URL/models. Check your network and LOCALCODE_BASE_URL. curl said: $out"
    return 1
  fi
  if ! print -r -- "$out" | jq -e '.data | type == "array" and length > 0' >/dev/null 2>&1; then
    LC_ERR="gateway returned no models. Check MASA_TOKEN. Reply: $(print -r -- "$out" | head -c 300)"
    return 1
  fi
  MODELS_JSON="$out"
}

select_model() {
  local ids row
  local -a list
  ids="$(print -r -- "$MODELS_JSON" | jq -r '.data[].id')"
  list=("${(@f)ids}")
  if [[ -n "${LOCALCODE_MODEL:-}" ]]; then
    if (( ! ${list[(Ie)$LOCALCODE_MODEL]} )); then
      LC_ERR="model $LOCALCODE_MODEL is not available on the gateway. Available: ${(j:, :)list}. Set LOCALCODE_MODEL to one of them, or unset it."
      return 1
    fi
    MODEL="$LOCALCODE_MODEL"
  else
    MODEL="${list[1]}"
  fi
  row="$(print -r -- "$MODELS_JSON" | jq -r --arg m "$MODEL" '.data[] | select(.id == $m) | [(.context_window // .max_model_len // 0), (.max_output_tokens // 0), (.limits.max_body_bytes // 0), (.limits.max_concurrent // 0)] | @tsv')"
  read -r CONTEXT_TOKENS MAX_TOKENS BODY_LIMIT_BYTES MAX_CONCURRENT <<<"$row"
  if (( CONTEXT_TOKENS <= 0 || MAX_TOKENS <= 0 )); then
    LC_ERR="the gateway does not report context_window and max_output_tokens for $MODEL. Ask the llm_proxy owner to upgrade llm_proxy, then retry."
    return 1
  fi
}

write_models() {
  local tmp reserve half
  tmp="$(mktemp)"
  print -r -- "$MODELS_JSON" | jq --arg url "$BASE_URL" '
    {providers: {masa: {
      baseUrl: $url,
      api: "openai-completions",
      apiKey: "$MASA_TOKEN",
      models: [.data[]
        | select((.context_window // .max_model_len // 0) > 0 and (.max_output_tokens // 0) > 0)
        | {id: .id, name: (.id + " (abila gateway)"), reasoning: false, input: ["text"],
           contextWindow: (.context_window // .max_model_len), maxTokens: .max_output_tokens,
           cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0}}]
    }}}' >"$tmp" || die "cannot build models.json from the gateway reply"
  mv "$tmp" "$LC_HOME/models.json"
  half=$(( CONTEXT_TOKENS / 2 ))
  reserve=$(( MAX_TOKENS < half ? MAX_TOKENS : half ))
  tmp="$(mktemp)"
  jq --arg key "masa/$MODEL" --argjson reserve "$reserve" \
    '.compaction.modelOverrides[$key].reserveTokens = $reserve' \
    "$LC_HOME/settings.json" >"$tmp" || die "cannot update $LC_HOME/settings.json. Is the file valid JSON?"
  mv "$tmp" "$LC_HOME/settings.json"
}

sync_models() {
  need_tool jq "Install: brew install jq"
  [[ -n "$MASA_TOKEN" ]] || die "export MASA_TOKEN=<your gateway token>, or set LOCAL_LLM_API_KEY"
  fetch_models || die "$LC_ERR"
  select_model || die "$LC_ERR"
  write_models
}

check() {
  local label="$1" ok="$2" detail="${3:-}"
  if [[ "$ok" == "0" ]]; then
    print -r -- "ok       $label${detail:+  $detail}"
  else
    print -r -- "PROBLEM  $label${detail:+  $detail}"
    rc=1
  fi
}

install_kind() {
  if [[ -d "$ROOT/.git" ]]; then
    print -r -- clone
  elif [[ "$ROOT" == */Cellar/localcode/* ]]; then
    print -r -- brew
  else
    print -r -- unknown
  fi
}

latest_version() {
  curl -fsS -m 5 "$RELEASES_URL" 2>/dev/null | jq -r '.tag_name // empty | ltrimstr("v")' 2>/dev/null || true
}

newer_than() {
  [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" == "$1" ]]
}

case "${1:-}" in
  run | init | update | doctor | models | install | remove | uninstall | packages | exa | gh | config | version | help | --help | -h)
    cmd="${1:-run}"
    shift
    ;;
  *)
    cmd=run
    ;;
esac

case "$cmd" in
  run)
    need_tool pi "Install pi from https://pi.dev: npm install -g @earendil-works/pi-coding-agent"
    seed
    sync_models
    args=(--model "masa/$MODEL" --append-system-prompt "$ROOT/config/system.md")
    if exa_enabled; then
      args+=(-e "$LC_HOME/extensions/exa.ts")
    fi
    PI_CODING_AGENT_DIR="$LC_HOME" exec pi "${args[@]}" "$@"
    ;;

  init)
    seed
    print -r -- "config dir: $LC_HOME"
    print -r -- "gateway:    $BASE_URL"
    if [[ -z "$MASA_TOKEN" ]]; then
      print -r -- "model:      unknown. Export MASA_TOKEN=<your gateway token>, then run: localcode init"
    elif fetch_models && select_model; then
      write_models
      print -r -- "model:      masa/$MODEL"
      print -r -- "context:    $CONTEXT_TOKENS tokens, max output $MAX_TOKENS tokens"
    else
      print -r -- "model:      unknown. $LC_ERR"
    fi
    exa_state=off
    if exa_enabled; then exa_state=on; fi
    print -r -- "web tools:  bundled Exa $exa_state"
    ;;

  update)
    latest="$(latest_version)"
    if [[ "${1:-}" == "--check" ]]; then
      print -r -- "localcode $VERSION"
      if [[ -z "$latest" ]]; then
        print -r -- "latest:   unknown, could not read $RELEASES_URL"
      elif newer_than "$latest" "$VERSION"; then
        print -r -- "latest:   $latest. Run: localcode update"
      else
        print -r -- "latest:   $latest, you are up to date"
      fi
      exit 0
    fi
    [[ $# -eq 0 ]] || die "usage: localcode update [--check]"
    case "$(install_kind)" in
      brew)
        need_tool brew
        brew upgrade "$TAP_FORMULA"
        exec "$(brew --prefix "$TAP_FORMULA")/bin/localcode" init
        ;;
      clone)
        need_tool git
        git -C "$ROOT" pull --ff-only || die "cannot fast-forward $ROOT. Commit or stash local changes, then run: git -C $ROOT pull"
        exec "$ROOT/bin/localcode" init
        ;;
      *)
        die "cannot tell how localcode was installed. Reinstall with: brew install $TAP_FORMULA"
        ;;
    esac
    ;;

  doctor)
    rc=0
    if command -v pi >/dev/null 2>&1; then ok=0; else ok=1; fi
    ver="$(pi --version 2>/dev/null | head -1 || true)"
    check "pi on PATH" "$ok" "${ver:-missing, install from https://pi.dev}"
    if [[ -n "$ver" ]]; then
      low="$(printf '%s\n0.86.0\n' "$ver" | sort -V | head -1)"
      if [[ "$low" != "0.86.0" ]]; then
        print -r -- "note     pi $ver is older than 0.86.0. Third-party web tools stay in the prompt at all times. Run: pi update --self"
      fi
    fi
    if command -v jq >/dev/null 2>&1; then ok=0; else ok=1; fi
    check "jq on PATH" "$ok"
    if command -v git >/dev/null 2>&1; then ok=0; else ok=1; fi
    check "git on PATH" "$ok"
    if command -v gh >/dev/null 2>&1; then ok=0; else ok=1; fi
    check "gh on PATH" "$ok" "$(gh --version 2>/dev/null | head -1 || print 'missing, install: brew install gh')"
    if [[ -n "$MASA_TOKEN" ]]; then ok=0; detail="len ${#MASA_TOKEN}, value withheld"; else ok=1; detail="get a token from the llm_proxy owner, then: export MASA_TOKEN=<token>"; fi
    check "MASA_TOKEN set" "$ok" "  $detail"
    if [[ -n "$MASA_TOKEN" ]]; then
      if fetch_models; then ok=0; else ok=1; fi
      check "gateway model list" "$ok" "${LC_ERR:-}"
      if [[ $ok -eq 0 ]]; then
        print -r -- "$MODELS_JSON" | jq -r '.data[] | "           \(.id)  context \(.context_window // .max_model_len // "unknown")  max output \(.max_output_tokens // "unknown")"'
        if select_model; then ok=0; else ok=1; fi
        check "selected model" "$ok" "${MODEL:+$MODEL}${LC_ERR:+  $LC_ERR}"
        if [[ $ok -eq 0 ]]; then
          budget=$(( CONTEXT_TOKENS * 4 ))
          if (( BODY_LIMIT_BYTES <= 0 )); then
            check "request body budget" 1 "gateway did not report max_body_bytes. Ask the llm_proxy owner to upgrade llm_proxy."
          else
            if [[ $budget -lt $BODY_LIMIT_BYTES ]]; then ok=0; else ok=1; fi
            detail="${CONTEXT_TOKENS} tokens x ~4 bytes = ${budget} bytes, gateway caps at ${BODY_LIMIT_BYTES}."
            if [[ $ok -ne 0 ]]; then detail+=" A full context may fail with HTTP 413. Ask the llm_proxy owner to raise max_body_bytes."; fi
            check "request body budget" "$ok" "$detail"
          fi
        fi
      fi
    fi
    if [[ -d "$LC_HOME" ]] || mkdir -p "$LC_HOME" 2>/dev/null; then ok=0; else ok=1; fi
    if [[ $ok -eq 0 ]]; then
      if touch "$LC_HOME/.probe" 2>/dev/null; then ok=0; else ok=1; fi
      check "config dir writable" "$ok" "$LC_HOME"
      rm -f "$LC_HOME/.probe"
    else
      check "config dir writable" 1 "$LC_HOME"
    fi
    if command -v gh >/dev/null 2>&1; then
      auth="$(gh auth status 2>&1 || true)"
      if print -r -- "$auth" | grep -q 'Logged in'; then ok=0; else ok=1; fi
      check "gh authenticated" "$ok"
      print -r -- "$auth" | sed 's/^/           /'
    fi
    if [[ -n "${EXA_API_KEY:-}" ]]; then ok=0; detail="bundled web_search ready, value withheld"; else ok=1; detail="bundled web_search errors until you export one, or install another package"; fi
    check "EXA_API_KEY set" "$ok" "  $detail"
    latest="$(latest_version)"
    if [[ -n "$latest" ]] && newer_than "$latest" "$VERSION"; then
      print -r -- "note     localcode $latest is available, you run $VERSION. Run: localcode update"
    fi
    if (( MAX_CONCURRENT > 0 )); then
      print -r -- "note     the gateway allows $MAX_CONCURRENT concurrent requests per token. Run one localcode session per token."
    fi
    exit "$rc"
    ;;

  models)
    need_tool jq "Install: brew install jq"
    [[ $# -eq 0 ]] || die "usage: localcode models. localcode writes models.json itself on every start"
    [[ -n "$MASA_TOKEN" ]] || die "export MASA_TOKEN=<your gateway token>, or set LOCAL_LLM_API_KEY"
    fetch_models || die "$LC_ERR"
    print -r -- "$MODELS_JSON" | jq -r '.data[] | [.id, (.context_window // .max_model_len // "unknown"), (.max_output_tokens // "unknown")] | @tsv' | column -t -s $'\t'
    ;;

  install | remove | uninstall)
    need_tool pi
    [[ $# -ge 1 ]] || die "usage: localcode $cmd <source>"
    PI_CODING_AGENT_DIR="$LC_HOME" exec pi "$cmd" "$@"
    ;;

  packages)
    need_tool pi
    PI_CODING_AGENT_DIR="$LC_HOME" exec pi list
    ;;

  exa)
    case "${1:-}" in
      off) mkdir -p "$LC_HOME" && touch "$LC_HOME/exa.disabled" && print -r -- "bundled Exa tools off" ;;
      on) rm -f "$LC_HOME/exa.disabled" && print -r -- "bundled Exa tools on" ;;
      *) die "usage: localcode exa on|off" ;;
    esac
    ;;

  gh)
    need_tool gh "Install: brew install gh, then run: gh auth login"
    exec gh "$@"
    ;;

  config)
    exa_state=off
    if exa_enabled; then exa_state=on; fi
    print -r -- "project:       $ROOT"
    print -r -- "config dir:    $LC_HOME"
    print -r -- "gateway:       $BASE_URL"
    if [[ -n "$MASA_TOKEN" ]] && fetch_models && select_model; then
      print -r -- "model:         masa/$MODEL"
      print -r -- "context:       $CONTEXT_TOKENS tokens"
      print -r -- "max output:    $MAX_TOKENS tokens"
    else
      print -r -- "model:         unknown. ${LC_ERR:-Export MASA_TOKEN=<your gateway token> to read it from the gateway.}"
    fi
    print -r -- "web tools:     bundled Exa $exa_state"
    print -r -- "MASA_TOKEN:    ${MASA_TOKEN:+set, len ${#MASA_TOKEN}}"
    print -r -- "EXA_API_KEY:   ${EXA_API_KEY:+set}"
    ;;

  version)
    print -r -- "localcode $VERSION"
    print -r -- "pi $(pi --version 2>/dev/null || print 'not installed')"
    print -r -- "node $(node -v 2>/dev/null || print 'not installed')"
    ;;

  help | --help | -h)
    usage
    ;;

  *)
    usage
    die "unknown command: $cmd"
    ;;
esac
